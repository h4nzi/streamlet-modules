{
  "id": "nahnoji",
  "name": "NaHnoji",
  "version": "1.0.0",
  "author": "jkmh",
  "description": "NaHnoji.cz – streamovací modul",
  "media": ["movies", "series"],
  "type": ["stream"],
  "website": "http://nahnoji.cz",
  "repository": "https://raw.githubusercontent.com/h4nzi/streamlet-modules/master/stream/nahnoji.json",
  "baseUrl": "http://nahnoji.cz",
  "responseFormat": "scraper",

  "scraper": [
    {
      "name": "Vyhledávání",
      "type": "stream_search",
      "url": "/hledej?q={title}",
      "mapping": {
        "id": "regex(attribute(a, href), 'id=([0-9]+)', 1)",
        "name": "selector(div.name)",
        "type": "video",
        "img": "attribute(img, src)",
        "link": "attribute(a, href)"
      }
    },

    {
      "name": "Přímý stream",
      "type": "stream",
      "url": "{link}?do=download",
    }
  ]
}
